# Admin panel credentials (required for /admin)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Required on Vercel (and any serverless host) for image + catalog writes.
# Create a Blob store in the Vercel dashboard and copy BLOB_READ_WRITE_TOKEN.
# Local disk uploads still work without this when running `next dev` / `next start` on a VPS.
BLOB_READ_WRITE_TOKEN=
